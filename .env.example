# ==========================================
# Configuración Docker Compose & PostgreSQL
# ==========================================
POSTGRES_DB=tecnm_sspp
POSTGRES_USER=tecnm_app
POSTGRES_PASSWORD=tecnm_dev_pass
POSTGRES_PORT=5432

# ==========================================
# Cadena de conexión para Backend .NET
# ==========================================
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=tecnm_sspp;Username=tecnm_app;Password=tecnm_dev_pass"

# ==========================================
# Autenticación JWT (Mínimo 32 bytes UTF-8)
# ==========================================
Jwt__SecretKey="TecNM_SSPP_Secret_Key_Dev_2026_Minimum_32_Bytes!"

# ==========================================
# CORS Frontend
# ==========================================
Cors__AllowedOrigin="http://localhost:3000,https://localhost:5173,https://localhost:5900"
